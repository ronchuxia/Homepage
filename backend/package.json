{
  "name": "homepage-chat-backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Multi-provider chat backend for the homepage AI agent.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env.local src/server.js",
    "start": "node --env-file-if-exists=.env.local src/server.js",
    "build:corpus": "node scripts/build-corpus.mjs",
    "test": "node --experimental-test-module-mocks --test tests/*.test.js",
    "test:watch": "node --test --watch tests/*.test.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.106.0",
    "@aws-sdk/client-s3": "^3.1088.0",
    "openai": "^6.46.0"
  }
}
